{
  "manifest_version": 3,
  "name": "AI PC Bridge (Gemini + DeepSeek)",
  "version": "6.2",
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://gemini.google.com/u/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}